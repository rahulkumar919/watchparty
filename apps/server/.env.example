# Server Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Database ────────────────────────────────────────────────────────────────
# Local PostgreSQL: postgresql://USER:PASSWORD@localhost:5432/watchparty_dev
# Neon:            postgresql://USER:PASSWORD@ep-xxx.region.neon.tech/watchparty?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/watchparty_dev

# ─── JWT / Session ───────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=24h

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# ─── Production (Render) — only set these in production ──────────────────────
# DATABASE_URL=postgresql://...?sslmode=require
# CORS_ORIGIN=https://your-frontend.onrender.com
