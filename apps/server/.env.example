# Server Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Database ────────────────────────────────────────────────────────────────
# Neon: use the POOLER URL for DATABASE_URL (runtime) + DIRECT_URL for migrations.
# The pooler wakes a suspended Neon instance on first connection and pools connections.
# PgBouncer mode (pgbouncer=true) is required when using the pooler with Prisma.
#
# DATABASE_URL = pooler (runtime)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.neon.tech/dbname?sslmode=require&pgbouncer=true&connect_timeout=30
# DIRECT_URL = direct host (migrations / prisma studio only)
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.region.neon.tech/dbname?sslmode=require&connect_timeout=30
#
# Local Docker (no pooler needed):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/watchparty_dev

# ─── JWT / Session ───────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=24h

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# ─── Production (Render) — only set these in production ──────────────────────
# DATABASE_URL=postgresql://...?sslmode=require&pgbouncer=true
# DIRECT_URL=postgresql://...?sslmode=require
# CORS_ORIGIN=https://your-frontend.onrender.com
