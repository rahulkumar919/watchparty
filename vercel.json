{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,

  "comment": "WatchParty — Vercel config for the Next.js frontend only.",
  "comment2": "The backend (Express + Socket.IO) CANNOT run on Vercel (serverless has no persistent WebSocket support).",
  "comment3": "Deploy the backend to Render (see render.yaml) and set the env vars below.",

  "buildCommand": "cd apps/web && npm run build",
  "outputDirectory": "apps/web/.next",
  "installCommand": "npm install",
  "framework": "nextjs",

  "env": {
    "NEXT_PUBLIC_API_URL":    "@watchparty_api_url",
    "NEXT_PUBLIC_SOCKET_URL": "@watchparty_socket_url"
  },

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
